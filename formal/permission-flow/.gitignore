# Checker output and caches.
quint/out/
quint/_apalache-out/
quint/repro/.cache/
**/.vite/
**/.vite-cache/

# The frozen evaluation keeps only its summaries; raw output and generated
# variants were never committed.
evaluation/*/out/*
!evaluation/fsl/out/SUMMARY.txt
!evaluation/tlaplus/out/SUMMARY.txt
evaluation/fsl/variants/
evaluation/tlaplus/cfg/
evaluation/tlaplus/states/
evaluation/fsl/sketch/node_modules
