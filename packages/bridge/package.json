{
  "name": "@ccpocket/bridge",
  "version": "1.92.0",
  "description": "Bridge server that connects Claude Agent SDK and Codex CLI sessions to mobile devices via WebSocket",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "K9i",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K9i-0/ccpocket.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/K9i-0/ccpocket/tree/main/packages/bridge#readme",
  "bugs": {
    "url": "https://github.com/K9i-0/ccpocket/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "bridge",
    "websocket",
    "mobile",
    "cli",
    "remote",
    "coding-agent"
  ],
  "bin": {
    "ccpocket-bridge": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "env -u CLAUDECODE tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "tsc",
    "test": "vitest run",
    "test:windows-smoke": "vitest run src/path-utils.test.ts src/websocket.test.ts src/codex-process.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "doctor": "tsx src/cli.ts doctor"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socks": "^2.8.10",
    "undici": "^8.12.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
